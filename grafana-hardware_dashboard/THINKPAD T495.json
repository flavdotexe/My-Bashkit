{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource Prometheus apontando para o node_exporter do seu Arch Linux",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "id": null,
  "uid": "arch-hardware-supervisorio",
  "title": "Supervisório de Hardware - Arch Linux",
  "description": "CPU (uso, temperatura, fans), memória (dual channel, zram), saúde do NVMe e histórico de montagens/RAID",
  "tags": ["hardware", "arch-linux", "cpu", "memoria", "nvme", "raid"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m"]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "mountpoint",
        "type": "query",
        "label": "Ponto de montagem (NVMe)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(node_filesystem_size_bytes{fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"}, mountpoint)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": { "text": "/", "value": "/" }
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "🖥️ CPU", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "id": 1, "type": "gauge", "title": "Uso Total de CPU (%)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "uso" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 70 },
          { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 2, "type": "timeseries", "title": "Uso por Núcleo (%)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]) * 100)", "legendFormat": "core {{cpu}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
        "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Temperatura da CPU (°C)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Requer lm_sensors configurado (sudo sensors-detect). Mostra todos os sensores hwmon — use a legenda para identificar chip/sensor (coretemp = Intel, k10temp/zenpower = AMD).",
      "targets": [ { "expr": "node_hwmon_temp_celsius", "legendFormat": "{{chip}} {{sensor}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }, "unit": "celsius",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 75 },
          { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Velocidade dos Fans (RPM)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Requer lm_sensors configurado e driver do Super I/O da placa-mãe carregado (ex.: nct6775, it87).",
      "targets": [ { "expr": "node_hwmon_fan_rpm", "legendFormat": "{{chip}} {{sensor}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }, "unit": "rotrpm" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 200, "type": "row", "title": "🧠 Memória", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "panels": [] },

    {
      "id": 5, "type": "stat", "title": "Memória Usada (%)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "uso" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 75 },
          { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 6, "type": "timeseries", "title": "Uso de Memória (GB)",
      "gridPos": { "h": 6, "w": 12, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes / 1024/1024/1024", "legendFormat": "Total" },
        { "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024/1024/1024", "legendFormat": "Usada" },
        { "expr": "node_memory_MemAvailable_bytes / 1024/1024/1024", "legendFormat": "Disponível" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "decgbytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7, "type": "stat", "title": "Dual Channel",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "max(memory_dual_channel_active)", "legendFormat": "status" } ],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": {
          "0": { "text": "Single Channel", "color": "orange" },
          "1": { "text": "Dual Channel", "color": "green" }
        } }
      ], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 8, "type": "table", "title": "Módulos de Memória (DIMMs)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "memory_dimm_info", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "locator": "Slot", "size": "Tamanho", "speed": "Velocidade", "manufacturer": "Fabricante", "part_number": "Part Number" } } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 9, "type": "stat", "title": "Taxa de Compressão zram",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "avg(zram_device_compression_ratio)", "legendFormat": "ratio" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 10, "type": "stat", "title": "zram Usado (%)",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "avg(zram_device_used_percent)", "legendFormat": "uso" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 60 },
          { "color": "red", "value": 85 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 11, "type": "timeseries", "title": "zram: Original vs Comprimido (MB)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "zram_device_original_bytes / 1024/1024", "legendFormat": "Original {{device}}" },
        { "expr": "zram_device_compressed_bytes / 1024/1024", "legendFormat": "Comprimido {{device}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "decmbytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 300, "type": "row", "title": "💽 NVMe", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "panels": [] },

    {
      "id": 12, "type": "stat", "title": "Temperatura NVMe (°C)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "nvme_temperature_celsius", "legendFormat": "{{device}}" } ],
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 60 },
          { "color": "red", "value": 75 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 13, "type": "stat", "title": "% Vida Útil Usada (desgaste)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "nvme_percentage_used", "legendFormat": "{{device}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 70 },
          { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 14, "type": "stat", "title": "Spare Disponível (%)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "nvme_available_spare_percent", "legendFormat": "{{device}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 50 },
          { "color": "green", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 15, "type": "stat", "title": "Erros de Mídia",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "nvme_media_errors_total", "legendFormat": "{{device}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 16, "type": "gauge", "title": "% de Armazenamento Usado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"$mountpoint\"} / node_filesystem_size_bytes{mountpoint=\"$mountpoint\"})) * 100", "legendFormat": "uso" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 75 },
          { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 17, "type": "timeseries", "title": "Temperatura NVMe ao Longo do Tempo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "nvme_temperature_celsius", "legendFormat": "{{device}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }, "unit": "celsius" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 400, "type": "row", "title": "🗄️ Armazenamento — Montagens & RAID", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 }, "panels": [] },

    {
      "id": 18, "type": "table", "title": "Histórico de Montagens",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "mount_event_info", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "action": "Ação", "device": "Dispositivo", "mountpoint": "Ponto de Montagem", "fstype": "Sistema de Arquivos", "Value": "Quando" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [ { "field": "Quando", "desc": true } ] } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Quando" }, "properties": [ { "id": "unit", "value": "dateTimeAsIso" } ] }
      ] },
      "options": { "showHeader": true }
    },
    {
      "id": 19, "type": "stat", "title": "Dispositivos Montados Agora",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "mount_currently_mounted_devices", "legendFormat": "dispositivos" } ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 20, "type": "stat", "title": "Status RAID",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "raid_configured", "legendFormat": "status" } ],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": {
          "0": { "text": "Não configurado", "color": "text" },
          "1": { "text": "Configurado", "color": "green" }
        } }
      ], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 21, "type": "table", "title": "Detalhes dos Arrays RAID",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "raid_array_info", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "array": "Array", "level": "Nível", "state": "Estado" } } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    }
  ]
}
