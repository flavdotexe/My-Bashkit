# ==========================================
# DNS SINKHOLE - ARCH LINUX
# ==========================================

# Escutar somente no localhost
listen-address=127.0.0.1
bind-interfaces
port=53

# Não utilizar o DNS do sistema
no-resolv

# DNS upstream
server=1.1.1.1
server=9.9.9.9

# Segurança e privacidade
domain-needed
bogus-priv
stop-dns-rebind

# Cache
cache-size=1000

# Carregar regras de bloqueio
conf-dir=/etc/dns-sinkhole/blocklists,*.conf

# Logs no journal
log-queries
log-facility=-

