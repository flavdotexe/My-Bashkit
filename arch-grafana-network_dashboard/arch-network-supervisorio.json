{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource Prometheus apontando para o node_exporter do seu Arch Linux",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "id": null,
  "uid": "arch-net-supervisorio",
  "title": "Supervisório de Rede - Arch Linux",
  "description": "SSH brute force/DDoS, dispositivos no hotspot e consumo de banda (download/upload)",
  "tags": ["rede", "arch-linux", "ssh", "seguranca", "hotspot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "interface",
        "type": "query",
        "label": "Interface de rede",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(node_network_receive_bytes_total, device)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "regex": "/^(?!lo$|veth|docker|br-).*/",
        "current": {}
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "🔒 Segurança SSH — Brute Force / DDoS", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "id": 1, "type": "stat", "title": "Tentativas Falhas (últimos 5 min)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "sum(ssh_failed_login_total)", "legendFormat": "falhas" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 5 },
          { "color": "red", "value": 15 }
        ] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2, "type": "stat", "title": "IPs Únicos Atacantes",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "ssh_unique_attacker_ips", "legendFormat": "IPs" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 3 },
          { "color": "red", "value": 8 }
        ] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 3, "type": "stat", "title": "Conexões na porta SSH (5 min) — indicador de DDoS/scan",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "ssh_connection_attempts_total", "legendFormat": "conexões" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 30 },
          { "color": "red", "value": 100 }
        ] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 4, "type": "stat", "title": "IPs Banidos (fail2ban)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "ssh_fail2ban_banned_ips", "legendFormat": "banidos" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "blue", "value": null }
        ] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Tentativas de Login Falhas ao Longo do Tempo (detecção de brute force)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "ssh_failed_login_total", "legendFormat": "tentativas falhas" },
        { "expr": "ssh_connection_attempts_total", "legendFormat": "conexões totais" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true,
        "thresholdsStyle": { "mode": "line" } }, "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 15 }
        ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "table", "title": "Top IPs Atacantes (janela atual)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "topk(10, ssh_failed_login_attempts_total)", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "ip": "IP Atacante", "Value": "Tentativas" } } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "color-background" } },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 3 },
          { "color": "red", "value": 10 }
        ] } }, "overrides": [] },
      "options": { "showHeader": true }
    },

    { "id": 200, "type": "row", "title": "📶 Dispositivos Conectados ao Hotspot", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },

    {
      "id": 7, "type": "stat", "title": "Dispositivos Conectados Agora",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "hotspot_connected_devices", "legendFormat": "dispositivos" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "blue", "value": null },
          { "color": "orange", "value": 5 },
          { "color": "red", "value": 10 }
        ] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 8, "type": "table", "title": "Lista de Dispositivos no Hotspot (MAC / IP / Hostname)",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "hotspot_device_info", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "mac": "MAC Address", "ip": "IP", "hostname": "Hostname", "iface": "Interface" } } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 9, "type": "timeseries", "title": "Histórico de Dispositivos Conectados",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "hotspot_connected_devices", "legendFormat": "dispositivos conectados" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },

    { "id": 300, "type": "row", "title": "💾 Consumo de Dados (GB) — Resumo", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "panels": [] },

    {
      "id": 10, "type": "stat", "title": "Download Total (GB) - Últimas 24h",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "increase(node_network_receive_bytes_total{device=\"$interface\"}[24h]) / 1024/1024/1024", "legendFormat": "download" } ],
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 11, "type": "stat", "title": "Upload Total (GB) - Últimas 24h",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "increase(node_network_transmit_bytes_total{device=\"$interface\"}[24h]) / 1024/1024/1024", "legendFormat": "upload" } ],
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 12, "type": "gauge", "title": "Download (GB) — Período Selecionado no Dashboard",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "increase(node_network_receive_bytes_total{device=\"$interface\"}[$__range]) / 1024/1024/1024", "legendFormat": "download" } ],
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2, "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 50 },
          { "color": "red", "value": 80 }
        ] } }, "overrides": [] },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 13, "type": "gauge", "title": "Upload (GB) — Período Selecionado no Dashboard",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "increase(node_network_transmit_bytes_total{device=\"$interface\"}[$__range]) / 1024/1024/1024", "legendFormat": "upload" } ],
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2, "min": 0, "max": 50,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 20 },
          { "color": "red", "value": 35 }
        ] } }, "overrides": [] },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },

    { "id": 400, "type": "row", "title": "📈 Gráficos de Download e Upload", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "panels": [] },

    {
      "id": 14, "type": "timeseries", "title": "Taxa de Download / Upload (Mbps)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device=\"$interface\"}[1m]) * 8 / 1000000", "legendFormat": "Download (Mbps)" },
        { "expr": "rate(node_network_transmit_bytes_total{device=\"$interface\"}[1m]) * -8 / 1000000", "legendFormat": "Upload (Mbps)" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "spanNulls": true },
        "unit": "Mbits" }, "overrides": [
          { "matcher": { "id": "byName", "options": "Download (Mbps)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Upload (Mbps)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 15, "type": "timeseries", "title": "Consumo Acumulado (GB) — Download vs Upload",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "(node_network_receive_bytes_total{device=\"$interface\"} - node_network_receive_bytes_total{device=\"$interface\"} @ start()) / 1024/1024/1024", "legendFormat": "Download acumulado (GB)" },
        { "expr": "(node_network_transmit_bytes_total{device=\"$interface\"} - node_network_transmit_bytes_total{device=\"$interface\"} @ start()) / 1024/1024/1024", "legendFormat": "Upload acumulado (GB)" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "decgbytes" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Download acumulado (GB)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Upload acumulado (GB)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
